# Groq API Key (Ultra-Fast Free Tier LLM for Sales Extraction & Risk Analysis)
# Get your free key instantly at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here


# Hugging Face Access Token (Free Serverless Inference API for Vector Embeddings)
# Model: sentence-transformers/all-MiniLM-L6-v2 (https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2)
# Get your free token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_access_token_here

# Server Port (Default: 5000)
PORT=5000
